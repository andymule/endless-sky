{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Endless Sky",
            "type": "shell",
            "command": "./build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true,
                "echo": true,
                "focus": false
            },
            "problemMatcher": [
                "$gcc",
                "$cmake"
            ],
            "options": {
                "env": {
                    "CMAKE_BUILD_PARALLEL_LEVEL": "$(sysctl -n hw.ncpu)"
                }
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rm -rf build && ./build.sh",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "problemMatcher": [
                "$gcc",
                "$cmake"
            ]
        },
        {
            "label": "Run Endless Sky",
            "type": "shell",
            "command": "./build/endless-sky",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "dependsOn": [
                "Build Endless Sky"
            ]
        }
    ]
} 