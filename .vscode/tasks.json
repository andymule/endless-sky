{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "shell",
            "command": "mkdir -p build && cmake -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_TOOLCHAIN_FILE=vcpkg/scripts/buildsystems/vcpkg.cmake -Dunofficial-minizip_DIR=$(pwd)/vcpkg/packages/minizip_arm64-osx/share/unofficial-minizip -DLIBMAD_INCLUDE_DIR=$(pwd)/vcpkg/packages/libmad_arm64-osx/include -DLIBMAD_LIB_RELEASE=$(pwd)/vcpkg/packages/libmad_arm64-osx/lib/libmad.a -DLIBMAD_LIB_DEBUG=$(pwd)/vcpkg/packages/libmad_arm64-osx/debug/lib/libmad.a",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Release",
            "type": "shell",
            "command": "mkdir -p build && cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=vcpkg/scripts/buildsystems/vcpkg.cmake -Dunofficial-minizip_DIR=$(pwd)/vcpkg/packages/minizip_arm64-osx/share/unofficial-minizip -DLIBMAD_INCLUDE_DIR=$(pwd)/vcpkg/packages/libmad_arm64-osx/include -DLIBMAD_LIB_RELEASE=$(pwd)/vcpkg/packages/libmad_arm64-osx/lib/libmad.a -DLIBMAD_LIB_DEBUG=$(pwd)/vcpkg/packages/libmad_arm64-osx/debug/lib/libmad.a",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build build -j$(sysctl -n hw.ncpu)",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm -rf build",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Full Build Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean",
                "Configure Debug",
                "Build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Full Build Release",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean",
                "Configure Release",
                "Build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Quick Build Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure Debug",
                "Build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Quick Build Release",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Configure Release",
                "Build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
} 