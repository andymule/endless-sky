{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch music-tester (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/music-tester/music-tester",
            "args": ["${workspaceFolder}/build/music-tester/sound_staging"],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib:${env:DYLD_LIBRARY_PATH}"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "Full Build Debug",
            "sourceMap": {
                "${workspaceFolder}/music-tester": "${workspaceFolder}/music-tester",
                "${workspaceFolder}/source": "${workspaceFolder}/source"
            }
        },
        {
            "name": "Launch music-tester (Release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/music-tester/music-tester",
            "args": ["${workspaceFolder}/build/music-tester/sound_staging"],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib:${env:DYLD_LIBRARY_PATH}"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "Full Build Release",
            "sourceMap": {
                "${workspaceFolder}/music-tester": "${workspaceFolder}/music-tester"
            }
        },
        {
            "name": "Launch Endless Sky (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/endless-sky",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib:${env:DYLD_LIBRARY_PATH}"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "Full Build Debug",
            "sourceMap": {
                "${workspaceFolder}/source": "${workspaceFolder}/source"
            }
        },
        {
            "name": "Launch Endless Sky (Release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/endless-sky",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib:${env:DYLD_LIBRARY_PATH}"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "Full Build Release",
            "sourceMap": {
                "${workspaceFolder}/source": "${workspaceFolder}/source"
            }
        },
        {
            "name": "Attach to music-tester",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/build/music-tester/music-tester",
            "pid": "${command:pickProcess}"
        },
        {
            "name": "Attach to Endless Sky",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/build/endless-sky",
            "pid": "${command:pickProcess}"
        },
        {
            "name": "Launch music-tester (Fast)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/music-tester/build/music-tester",
            "args": ["${workspaceFolder}/music-tester/sound_staging"],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}/music-tester",
            "env": {
                "DYLD_LIBRARY_PATH": "${env:HOMEBREW_PREFIX}/lib:${env:DYLD_LIBRARY_PATH}"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "Build music-tester only",
            "sourceMap": {
                "${workspaceFolder}/music-tester": "${workspaceFolder}/music-tester",
                "${workspaceFolder}/source": "${workspaceFolder}/source"
            }
        }
    ]
} 