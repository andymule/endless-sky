        {
            "label": "Clean Build",
            "type": "shell",
            "command": "./build-macos.sh",
            "args": [
                "clean"
            ],
            "osx": {
                "command": "./build-macos.sh",
                "args": [
                    "clean"
                ]
            },
            "linux": {
                "command": "./build-linux.sh",
                "args": [
                    "clean"
                ]
            },
            "windows": {
                "command": "rmdir",
                "args": [
                    "/s",
                    "/q",
                    "build"
                ]
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Quick Build (Ninja Only - Unix)",
            "type": "shell",
            "command": "mkdir -p build && cd build && ninja",
            "osx": {
                "command": "mkdir -p build && cd build && ninja"
            },
            "linux": {
                "command": "mkdir -p build && cd build && ninja"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Run Dynamix (No Build - Windows)",
            "type": "shell",
            "command": "run-dynamix.bat",
            "windows": {
                "command": "run-dynamix.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
