        {
            "label": "Build and Run (Windows)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Dynamix (Fast - Windows)",
                "Copy DLLs (Windows)"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Build and Run (Unix)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Dynamix (Fast - Unix)",
                "Run Dynamix (No Build - Unix)"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "CMake Clean All",
            "type": "shell",
            "command": "rm -rf build",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
