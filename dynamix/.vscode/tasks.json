{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Dynamix (Release - Windows)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-windows.ps1",
                "-Config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Dynamix (Debug - Windows)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-windows.ps1",
                "-Config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build and Test (Windows)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-windows.ps1",
                "-Config",
                "Release",
                "-Tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Dynamix (Windows)",
            "type": "shell",
            "command": "${workspaceFolder}/run-dynamix.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Dynamix (Release - Unix)",
            "type": "shell",
            "command": "./build-macos.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "windows": {
                "command": "echo",
                "args": ["Unix build task skipped on Windows"]
            }
        },
        {
            "label": "Build Dynamix (Debug - Unix)",
            "type": "shell",
            "command": "./build-macos.sh",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "windows": {
                "command": "echo",
                "args": ["Unix build task skipped on Windows"]
            }
        }
    ]
}
