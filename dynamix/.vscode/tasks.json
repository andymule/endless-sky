{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Dynamix (Release - Windows)",
            "type": "shell",
            "command": "${workspaceFolder}/build-windows-fast.bat",
            "windows": {
                "command": "${workspaceFolder}/build-windows-fast.bat"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Build Dynamix (Release - Unix)",
            "type": "shell",
            "command": "./build-macos.sh",
            "osx": {
                "command": "./build-macos.sh"
            },
            "linux": {
                "command": "./build-linux.sh"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Build Dynamix (Debug - Windows)",
            "type": "shell",
            "command": "build-windows-debug.bat",
            "windows": {
                "command": "build-windows-debug.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
