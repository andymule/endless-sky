                },
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/usr/local/lib:/usr/lib/x86_64-linux-gnu:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "miDebuggerPath": "/usr/bin/lldb",
            "preLaunchTask": "Build Dynamix (Debug)"
        },
