{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Dynamix (Windows)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "preLaunchTask": "Build Dynamix (Debug - Windows)"
        },
        {
            "name": "Debug Dynamix (macOS/Linux)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:${env:DYLD_LIBRARY_PATH}",
                "LD_LIBRARY_PATH": "/usr/local/lib:/usr/lib/x86_64-linux-gnu:${env:LD_LIBRARY_PATH}"
            },
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.stop-on-sharedlibrary-events false"
            ],
            "preLaunchTask": "Build Dynamix (Debug - Unix)"
        },
        {
            "name": "Run Dynamix (Release - Windows)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "preLaunchTask": "Build Dynamix (Release - Windows)"
        },
        {
            "name": "Run Dynamix (Release - macOS/Linux)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:${env:DYLD_LIBRARY_PATH}",
                "LD_LIBRARY_PATH": "/usr/local/lib:/usr/lib/x86_64-linux-gnu:${env:LD_LIBRARY_PATH}"
            },
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.stop-on-sharedlibrary-events false"
            ],
            "preLaunchTask": "Build Dynamix (Release - Unix)"
        },
        {
            "name": "Build and Run (Fast - Windows)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "noDebug": true,
            "preLaunchTask": "Build and Run (Windows)"
        },
        {
            "name": "Build and Run (Fast - macOS/Linux)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "noDebug": true,
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:${env:DYLD_LIBRARY_PATH}",
                "LD_LIBRARY_PATH": "/usr/local/lib:/usr/lib/x86_64-linux-gnu:${env:LD_LIBRARY_PATH}"
            },
            "preLaunchTask": "Build Dynamix (Fast - Unix)"
        },
        {
            "name": "Run Dynamix (Direct - Windows)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
        },
        {
            "name": "Run Dynamix (Direct - macOS/Linux)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/dynamix",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:${env:DYLD_LIBRARY_PATH}",
                "LD_LIBRARY_PATH": "/usr/local/lib:/usr/lib/x86_64-linux-gnu:${env:LD_LIBRARY_PATH}"
            },
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.stop-on-sharedlibrary-events false"
            ]
        },
        {
            "name": "Clean Build (Windows)",
            "type": "lldb",
            "request": "launch",
            "program": "cmd.exe",
            "args": [
                "/c",
                "echo Cleaned build directory."
            ],
            "cwd": "${workspaceFolder}",
            "noDebug": true,
            "preLaunchTask": "Clean Build"
        },
        {
            "name": "Clean Build (macOS/Linux)",
            "type": "lldb",
            "request": "launch",
            "program": "/bin/echo",
            "args": [
                "Cleaned build directory."
            ],
            "cwd": "${workspaceFolder}",
            "noDebug": true,
            "preLaunchTask": "Clean Build"
        }
    ]
}